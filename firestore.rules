rules_version = '2';

// Kilonaut's cloud (CloudSync.kt, Friends.kt). Your training is yours alone; friends (people who
// follow each other) can read each other's summary stats and nothing else.
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function follows(a, b) { return exists(/databases/$(database)/documents/users/$(a)/following/$(b)); }
    // You, or a friend of [uid] (you follow each other).
    function canSee(uid) { return me() == uid || (follows(uid, me()) && follows(me(), uid)); }
    function postExists(uid, post) { return exists(/databases/$(database)/documents/users/$(uid)/posts/$(post)); }
    // [a] blocked [b].
    function blockedBy(a, b) { return exists(/databases/$(database)/documents/users/$(a)/blocked/$(b)); }

    // Workouts, weigh-ins and the plan: only the owner.
    match /users/{uid}/{collection}/{doc} {
      allow read, write: if signedIn() && me() == uid && collection in ['workouts', 'weighins', 'state'];
    }

    // Who you follow: you add and remove it; the person you follow can see it and remove it (declining).
    match /users/{uid}/following/{other} {
      allow read: if signedIn() && (me() == uid || me() == other);
      allow create: if signedIn() && me() == uid && other != uid && request.resource.data.uid == other
        && !blockedBy(other, uid);
      allow delete: if signedIn() && (me() == uid || me() == other);
    }

    // Your followers: each follower writes their own entry here when they follow you.
    match /users/{uid}/followers/{other} {
      allow read: if signedIn() && (me() == uid || me() == other);
      allow create: if signedIn() && me() == other && other != uid && request.resource.data.uid == other
        && !blockedBy(uid, other);
      allow delete: if signedIn() && (me() == uid || me() == other);
    }

    // Notes for notifications: written with the like, comment or follow they describe (which must
    // exist once the write is done), read and cleared by their owner.
    match /users/{uid}/inbox/{note} {
      allow read, delete: if signedIn() && me() == uid;
      allow create: if signedIn() && uid != me() && !blockedBy(uid, me())
        && request.resource.data.keys().hasOnly(['type', 'from', 'owner', 'post', 'comment', 'text', 'parent', 'at'])
        && request.resource.data.from == me()
        && request.resource.data.at == request.time
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 200))
        && (
          (request.resource.data.type == 'follow' && request.resource.data.owner == uid
            && existsAfter(/databases/$(database)/documents/users/$(uid)/followers/$(me())))
          || (request.resource.data.type == 'like' && request.resource.data.owner == uid
            && existsAfter(/databases/$(database)/documents/users/$(uid)/posts/$(request.resource.data.post)/likes/$(me())))
          || (request.resource.data.type == 'comment' && request.resource.data.owner == uid
            && getAfter(/databases/$(database)/documents/users/$(uid)/posts/$(request.resource.data.post)/comments/$(request.resource.data.comment)).data.uid == me())
          || (request.resource.data.type == 'clike'
            && existsAfter(/databases/$(database)/documents/users/$(request.resource.data.owner)/posts/$(request.resource.data.post)/comments/$(request.resource.data.comment)/likes/$(me()))
            && get(/databases/$(database)/documents/users/$(request.resource.data.owner)/posts/$(request.resource.data.post)/comments/$(request.resource.data.comment)).data.uid == uid)
          || (request.resource.data.type == 'reply'
            && getAfter(/databases/$(database)/documents/users/$(request.resource.data.owner)/posts/$(request.resource.data.post)/comments/$(request.resource.data.comment)).data.uid == me()
            && get(/databases/$(database)/documents/users/$(request.resource.data.owner)/posts/$(request.resource.data.post)/comments/$(request.resource.data.parent)).data.uid == uid)
        );
    }

    // Who you blocked: yours alone.
    match /users/{uid}/blocked/{other} {
      allow read, delete: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid && other != uid && request.resource.data.keys().hasOnly(['at']);
    }

    // Reports to the app's makers: anyone signed in can file one as themselves; nobody reads them
    // in the app (they're read in the Firebase console).
    match /reports/{report} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['by', 'uid', 'post', 'comment', 'reason', 'text', 'at'])
        && request.resource.data.by == me()
        && request.resource.data.uid is string
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 40
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 600))
        && request.resource.data.at == request.time;
    }

    // What friends see: written by you, read by you and by people you follow who follow you back.
    match /users/{uid}/public/{doc} {
      allow write: if signedIn() && me() == uid && doc == 'stats';
      allow read: if signedIn() && (me() == uid || (follows(uid, me()) && follows(me(), uid)));
    }

    // Posts: a workout you logged, with a few words; yours to write and delete (only the words can
    // change later; no photos); you and your friends read them.
    match /users/{uid}/posts/{post} {
      allow read: if signedIn() && canSee(uid);
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['text', 'workout', 'createdAt'])
        && request.resource.data.workout is string && request.resource.data.workout.size() <= 20000
        && request.resource.data.createdAt == request.time
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 300));
      allow update: if signedIn() && me() == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited'])
        && request.resource.data.edited == true
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 300));
      allow delete: if signedIn() && me() == uid;

      // A like is your own entry under the post; the author can clear them (deleting the post).
      match /likes/{liker} {
        allow read: if signedIn() && canSee(uid);
        allow create: if signedIn() && liker == me() && canSee(uid) && postExists(uid, post)
          && request.resource.data.keys().hasOnly(['at']);
        allow delete: if signedIn() && (liker == me() || me() == uid);
      }

      // Comments: friends and the author write their own; the writer or the author can delete one.
      match /comments/{comment} {
        allow read: if signedIn() && canSee(uid);
        allow create: if signedIn() && canSee(uid) && postExists(uid, post)
          && request.resource.data.keys().hasOnly(['uid', 'text', 'at', 'replyTo'])
          && (!('replyTo' in request.resource.data) || (request.resource.data.replyTo is string && request.resource.data.replyTo.size() <= 64))
          && request.resource.data.uid == me()
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && (resource.data.uid == me() || me() == uid);

        // Likes on a comment: your own entry; you, the post's author or the comment's writer clear them.
        match /likes/{liker} {
          allow read: if signedIn() && canSee(uid);
          allow create: if signedIn() && liker == me() && canSee(uid)
            && exists(/databases/$(database)/documents/users/$(uid)/posts/$(post)/comments/$(comment))
            && request.resource.data.keys().hasOnly(['at']);
          allow delete: if signedIn() && (liker == me() || me() == uid
            || get(/databases/$(database)/documents/users/$(uid)/posts/$(post)/comments/$(comment)).data.uid == me());
        }
      }
    }

    // Name, username, a short bio and a small profile picture, so people can find and recognise each other.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'handle', 'photo', 'bio'])
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 150))
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60))
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 150000));
      allow delete: if signedIn() && me() == uid;
    }

    // Usernames: first come, first served; only the holder can let one go.
    match /handles/{handle} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me() && handle.matches('^[a-z0-9_.]{3,20}$');
      allow update: if signedIn() && resource.data.uid == me() && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }
  }
}
