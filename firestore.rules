rules_version = '2';

// Kilonaut's cloud copy (CloudSync.kt). Each person can read and write only their own data,
// under users/{their uid}; nothing else in the database is reachable from the app.
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{collection}/{doc} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && collection in ['workouts', 'weighins', 'state'];
    }
  }
}
